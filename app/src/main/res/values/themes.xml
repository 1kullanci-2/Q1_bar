<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#3D6A12</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#C2DC7A</item>
        <item name="colorOnPrimaryContainer">#1B2A14</item>
        <item name="colorSecondaryContainer">#C9E08A</item>
        <item name="colorOnSecondaryContainer">#1B2A14</item>
        <item name="colorSurface">#EAF1D6</item>
        <item name="colorOnSurface">#1B2A14</item>
        <item name="colorSurfaceVariant">#CFDBB0</item>
        <item name="colorOnSurfaceVariant">#46583B</item>
        <item name="colorOutline">#8FA070</item>
        <item name="colorOutlineVariant">#BCCB9A</item>
        <item name="android:colorBackground">#DCE6C4</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <style name="PanelTheme" parent="android:Theme.DeviceDefault.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
